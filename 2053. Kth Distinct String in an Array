class Solution:
    def kthDistinct(self, arr: List[str], k: int) -> str:
        countdict = {}
        for a in arr:
            if a in countdict:
                countdict[a] +=1
            else:
                countdict[a] = 1

        
        for a in arr:
            if countdict[a] == 1:
                k-=1
                if k == 0:
                    return a
        
        return ""
